# ─── データベース（Supabase PostgreSQL）────────────────────────────────────
# Supabase Dashboard → Settings → Database → Connection string
# 本番: Transaction pooler（ポート 6543, ?pgbouncer=true）
# ローカル開発: Direct connection（ポート 5432）でも可
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# ─── データ移行用（Railway MySQL からの一回限り移行時のみ）────────────────
# MYSQL_URL=mysql://user:password@host:port/railway

# ─── JWT ─────────────────────────────────────────────────────────────────────
# 本番では必ず強力なランダム文字列に変更してください
JWT_SECRET=dev-secret-change-in-production

# ─── サーバー ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── OpenAI（任意）───────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here
